{
  "name": "merchants-bluff",
  "version": "0.0.0",
  "private": true,
  "overrides": { "@grpc/grpc-js": "1.14.6" },
  "engines": {
    "node": ">=24.12.0 <25"
  },
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run --project unit",
    "test:calculations": "vitest run --project unit tests/unit/ledger.test.ts tests/unit/resolution.test.ts tests/unit/scoring.test.ts",
    "test:integration": "vitest run --project integration",
    "test:e2e": "playwright test",
    "emulators": "node scripts/emulators.mjs start",
    "test:emulators": "node scripts/emulators.mjs integration",
    "test:m0": "node scripts/emulators.mjs m0",
    "test:local": "node scripts/emulators.mjs acceptance",
    "check:deployment": "node scripts/check-deployment-env.mjs",
    "test:deployment": "node --test tests/scripts/deployment-env.test.mjs"
  },
  "dependencies": {
    "firebase": "13.0.0",
    "firebase-admin": "14.5.0",
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@firebase/rules-unit-testing": "6.0.0",
    "@playwright/test": "1.64.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.0",
    "firebase-tools": "15.33.0",
    "typescript": "5.9.3",
    "vitest": "5.0.3"
  },
  "type": "module"
}
