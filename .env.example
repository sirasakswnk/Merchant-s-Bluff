# Local demo only. Copy to .env.local; no real Firebase project is needed for local play/tests.
NEXT_PUBLIC_USE_FIREBASE_EMULATORS=true
NEXT_PUBLIC_FIREBASE_API_KEY=demo-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=demo-merchants-bluff.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=demo-merchants-bluff
NEXT_PUBLIC_FIREBASE_DATABASE_URL=https://demo-merchants-bluff-default-rtdb.firebaseio.com
NEXT_PUBLIC_FIREBASE_APP_ID=demo-app-id
# On LAN, the browser uses location.hostname when this is empty.
NEXT_PUBLIC_FIREBASE_EMULATOR_HOST=
NEXT_PUBLIC_FIREBASE_AUTH_EMULATOR_PORT=19099
NEXT_PUBLIC_FIREBASE_DATABASE_EMULATOR_PORT=19000
FIREBASE_PROJECT_ID=demo-merchants-bluff
FIREBASE_DATABASE_URL=https://demo-merchants-bluff-default-rtdb.firebaseio.com
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:19099
FIREBASE_DATABASE_EMULATOR_HOST=127.0.0.1:19000
# Production/preview: disable emulators, replace ALL public/server config, and set:
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
