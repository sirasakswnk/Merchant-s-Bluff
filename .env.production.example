# Blank template only. Copy to .env.production.local for a local production check.
# Keep Vercel environment scopes separate. Shared merchant-s-bluff Firebase approved by user.
# Current setup and its shared-data scope: docs/production-setup.md.
NEXT_PUBLIC_USE_FIREBASE_EMULATORS=false
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_DATABASE_URL=
NEXT_PUBLIC_FIREBASE_APP_ID=
FIREBASE_PROJECT_ID=
FIREBASE_DATABASE_URL=
FIREBASE_CLIENT_EMAIL=
# Paste the service account private_key, quoted with literal \n or real newlines.
FIREBASE_PRIVATE_KEY=
# Empty overrides prevent the local demo .env.local hosts reaching next build/start.
# Remove these variables entirely in Vercel deployment settings.
FIREBASE_AUTH_EMULATOR_HOST=
FIREBASE_DATABASE_EMULATOR_HOST=
NEXT_PUBLIC_FIREBASE_EMULATOR_HOST=

# Optional production maintenance. Leave deletion disabled until target/Rules are reviewed.
CRON_SECRET=
RETENTION_APPLY_ENABLED=false
RETENTION_FIREBASE_PROJECT_ID=
